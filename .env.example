# Copy this file to .env and fill in real values.
# Never commit the real .env file to git or share it publicly.

# A long random string — used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin login for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Paystack (leave PAYSTACK_SECRET_KEY blank until you're ready to take real payments)
PAYSTACK_SECRET_KEY=

# Port the server listens on (most hosts set this automatically — leave blank to let them)
PORT=3000

NODE_ENV=production

# ------------------------------------------------------------
# Mikrotik — fill these in once you have the router.
# Leave blank for now; the site works fine without them, it will
# just log a reminder to add customers to the router by hand.
# ------------------------------------------------------------
MIKROTIK_HOST=
MIKROTIK_API_USER=
MIKROTIK_API_PASSWORD=
MIKROTIK_PORT=443
MIKROTIK_ALLOW_SELF_SIGNED=true
